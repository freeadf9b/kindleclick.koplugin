msgstr "Content-Type: text/plain; charset=UTF-8\nPlural-Forms: nplurals=1; plural=0;\n"

msgctxt "Kindle Click"
msgid "Bluetooth and Kindle Click Controller"
msgstr "Kindle蓝牙和翻页器"

msgctxt "Kindle Click"
msgid "Control Bluetooth on Kindle, connect Kindle Click automatically, recover a frozen Bluetooth stack, and show connection status in the reader footer, Bookends, or ZenOS."
msgstr "在 Kindle 上控制蓝牙、自动连接 Kindle Click、系统蓝牙假死时一键救回，并在阅读状态栏、Bookends 或 ZenOS 显示连接状态。"

msgctxt "Kindle Click"
msgid "The bundled icon font is installed. Restart KOReader to use it."
msgstr "已安装随插件附带的图标字体，请重启 KOReader 后生效"

msgctxt "Kindle Click"
msgid "Kindle Click: Toggle Bluetooth"
msgstr "Kindle Click：开/关蓝牙"

msgctxt "Kindle Click"
msgid "Kindle Click: Connect"
msgstr "Kindle Click：连接"

msgctxt "Kindle Click"
msgid "Kindle Click connected"
msgstr "Kindle Click 已连接"

msgctxt "Kindle Click"
msgid "The Bluetooth transport appears disconnected (WMT reference count is 0); waiting may not help.\nRebuilding stops and restarts Bluetooth services and takes about 40–60 seconds. Wi-Fi may briefly disconnect.\nRebuild it now?"
msgstr "蓝牙传输层似乎已断开（WMT 引用计数为 0），继续等待可能也开不了。\n重建会停止并重启蓝牙相关服务，约 40–60 秒；Wi-Fi 可能短暂中断。\n是否现在重建？"

msgctxt "Kindle Click"
msgid "Rebuild"
msgstr "重建"

msgctxt "Kindle Click"
msgid "Later"
msgstr "稍后"

msgctxt "Kindle Click"
msgid "Bluetooth is still starting. The plugin will not retry automatically; it will keep watching and you can toggle it later."
msgstr "系统蓝牙仍在启动。插件不再自动重试，会继续只读观察，也可以稍后手动切换。"

msgctxt "Kindle Click"
msgid "Checking for updates..."
msgstr "正在检查更新…"

msgctxt "Kindle Click"
msgid "There is no network connection. Connect to Wi-Fi before checking for updates."
msgstr "当前没有网络连接，请先连接 Wi-Fi 后再检查更新"

msgctxt "Kindle Click"
msgid "Update check failed: "
msgstr "检查更新失败："

msgctxt "Kindle Click"
msgid "Already up to date (v"
msgstr "已是最新版本（v"

msgctxt "Kindle Click"
msgid "Version v%s is available (current version: v%s).\nDownload and install it now? Restart KOReader after the update."
msgstr "发现新版本 v%s（当前 v%s）。\n现在下载并更新吗？更新后需要重启 KOReader。"

msgctxt "Kindle Click"
msgid "Update"
msgstr "更新"

msgctxt "Kindle Click"
msgid "Downloading the update. Keep the network connected..."
msgstr "正在下载更新，请保持网络连接…"

msgctxt "Kindle Click"
msgid "Update failed ("
msgstr "更新失败（"

msgctxt "Kindle Click"
msgid "). Check the network and try again."
msgstr "），请检查网络后重试"

msgctxt "Kindle Click"
msgid "Updated to v%s.\nRestart KOReader to apply the update."
msgstr "已更新到 v%s。\n重启 KOReader 后生效。"

msgctxt "Kindle Click"
msgid "Restart now"
msgstr "立即重启"

msgctxt "Kindle Click"
msgid "Turning Bluetooth on..."
msgstr "正在打开蓝牙…"

msgctxt "Kindle Click"
msgid "Turning Bluetooth off..."
msgstr "正在关闭蓝牙…"

msgctxt "Kindle Click"
msgid "Failed to turn Bluetooth on"
msgstr "蓝牙开启失败"

msgctxt "Kindle Click"
msgid "Failed to turn Bluetooth off"
msgstr "蓝牙关闭失败"

msgctxt "Kindle Click"
msgid "Bluetooth is on. Connecting to Kindle Click..."
msgstr "蓝牙已开启，正在连接 Kindle Click"

msgctxt "Kindle Click"
msgid "Bluetooth is off"
msgstr "蓝牙已关闭"

msgctxt "Kindle Click"
msgid "Bluetooth off"
msgstr "蓝牙关闭"

msgctxt "Kindle Click"
msgid "No paired Kindle Click found. Pair it in the Kindle system settings first."
msgstr "未找到已配对的 Kindle Click，请先在 Kindle 原生系统中配对"

msgctxt "Kindle Click"
msgid "Failed to connect to Kindle Click"
msgstr "连接 Kindle Click 失败"

msgctxt "Kindle Click"
msgid "Connecting to Kindle Click... If it takes too long, press a button on the Click."
msgstr "正在连接 Kindle Click…若较久未连上，请按一下 Click"

msgctxt "Kindle Click"
msgid "Cannot read Bluetooth status. Check the diagnostics first."
msgstr "无法读取蓝牙状态，请先查看诊断信息"

msgctxt "Kindle Click"
msgid "Connected device: Bluetooth status unknown"
msgstr "已连接设备：蓝牙状态未知"

msgctxt "Kindle Click"
msgid "Connected device: Bluetooth is off"
msgstr "已连接设备：蓝牙已关闭"

msgctxt "Kindle Click"
msgid "Connected device: "
msgstr "已连接设备："

msgctxt "Kindle Click"
msgid "None"
msgstr "无"

msgctxt "Kindle Click"
msgid "Kindle Click Diagnostics"
msgstr "Kindle Click 诊断信息"

msgctxt "Kindle Click"
msgid "This stops acsbtfd, btmanagerd, and wmt_service, then starts them in reverse order to reinitialize the Bluetooth transport.\nWi-Fi may briefly disconnect. If wmt does not start, the device may need to be restarted.\nUse only when Bluetooth cannot be enabled."
msgstr "会依次停止 acsbtfd、btmanagerd 和 wmt_service，再按相反顺序启动，让蓝牙传输层重新初始化。\n过程中 Wi-Fi 可能短暂中断；如果 wmt 起不来，可能需要重启设备。\n仅在蓝牙无法开启时使用。"

msgctxt "Kindle Click"
msgid "Continue"
msgstr "继续"

msgctxt "Kindle Click"
msgid "The transport is already being rebuilt. Please wait."
msgstr "传输层重建正在进行，请稍候"

msgctxt "Kindle Click"
msgid "Rebuilding the Bluetooth transport (about 40–60 seconds)..."
msgstr "正在重建蓝牙传输层（约 40–60 秒）…"

msgctxt "Kindle Click"
msgid "Bluetooth is back on. Connecting to Kindle Click..."
msgstr "蓝牙已重新开启，正在连接 Kindle Click"

msgctxt "Kindle Click"
msgid "The Bluetooth transport is still unavailable"
msgstr "蓝牙传输层仍未恢复"

msgctxt "Kindle Click"
msgid "Restart the device, or let it sleep for at least one minute and try again."
msgstr "建议重启设备，或合盖休眠 1 分钟以上再试"

